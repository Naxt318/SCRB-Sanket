# Copy this file to .env and adjust if needed.
PORT=8080
NODE_ENV=development
# Local Postgres. The app doesn't currently use any real tables (the schema
# file is an empty scaffold and data is served from an in-memory synthetic
# dataset), so this just needs to point at a reachable Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrb_sanket
