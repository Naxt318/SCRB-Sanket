# Copy this file to .env and fill in your Firebase project's web config
# (Firebase console → Project settings → General → "Your apps" → SDK setup
# and configuration → Config).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sarvam AI speech-to-text (voice input in chat). Get a key from
# https://dashboard.sarvam.ai — Speech to Text API.
# WARNING: this key is bundled into the frontend JS and visible to anyone
# who opens browser devtools. Fine for a demo/prototype; for production,
# call Sarvam from a backend instead of directly from the browser.
VITE_SARVAM_API_KEY=

# Google Gemini (free tier) — powers real AI answers in the chat assistant.
# Get a free key from https://aistudio.google.com/apikey (no credit card
# needed). If left blank, the app automatically falls back to its
# rule-based deterministic answers instead — nothing breaks either way.
VITE_GEMINI_API_KEY=

# Local dev server settings (optional — defaults work fine without these)
PORT=26259
BASE_PATH=/
