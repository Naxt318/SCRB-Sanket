# Sarvam AI speech-to-text (voice input in chat). Get a key from
# https://dashboard.sarvam.ai — Speech to Text API.
# WARNING: this key is bundled into the frontend JS and visible to anyone
# who opens browser devtools. Fine for a demo/prototype; for production,
# call Sarvam from a backend instead of directly from the browser.
VITE_SARVAM_API_KEY=

# Note: Gemini AI key is managed securely on the Express backend server (GEMINI_API_KEY).

# Local dev server settings (optional — defaults work fine without these)
PORT=26259
BASE_PATH=/
