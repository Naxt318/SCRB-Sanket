{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts-internal/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --filter \"!@workspace/mockup-sandbox\" --if-present run build && pnpm run deploy:prepare",
    "deploy:prepare": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('artifacts/scrb-sanket/dist/public','dist',{recursive:true})\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/scrb-sanket run dev",
    "dev:server": "pnpm --filter server run dev",
    "dev:all": "pnpm --parallel --filter server --filter @workspace/scrb-sanket run dev",
    "start": "pnpm --filter server run start"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
